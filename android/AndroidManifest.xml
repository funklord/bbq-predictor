<?xml version="1.0"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="se.vibes.bbq_predictor"
    android:installLocation="auto"
    android:versionCode="-- %%INSERT_VERSION_CODE%% --"
    android:versionName="-- %%INSERT_VERSION_NAME%% --">
    <!-- %%INSERT_PERMISSIONS -->
    <!-- %%INSERT_FEATURES -->
    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:smallScreens="true" />
    <!--
        Coarse location, and coarse deliberately (project.md sec 13.3).

        It is used to ask "which weather stations are near me", and the
        nearest one is hundreds of metres away at best. Fine location
        would buy nothing this program can use and would ask for more
        than it needs, which is the kind of permission a reader is right
        to refuse.

        Everything works without it: the list falls back to searching
        for a place by name, which is also the only route on a desktop.

        THE PACKAGE ALSO ASKS FOR ACCESS_FINE_LOCATION, and not from
        here. Qt Positioning declares it in its own dependency manifest
        and androiddeployqt injects it, which is visible only in the
        built artifact; see project.md sec 13.3. Removing it the
        Android way, with tools:node="remove", is refused by
        androiddeployqt's own XML handling before Gradle ever sees it.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>



    <application
        android:name="org.qtproject.qt.android.bindings.QtApplication"
        android:hardwareAccelerated="true"
        android:label="-- %%INSERT_APP_NAME%% --"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="true"
        android:fullBackupOnly="false">
        <activity
            android:name="org.qtproject.qt.android.bindings.QtActivity"
            android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density"
            android:label="-- %%INSERT_APP_NAME%% --"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.lib_name"
                android:value="-- %%INSERT_APP_LIB_NAME%% --" />

            <meta-data
                android:name="android.app.arguments"
                android:value="-- %%INSERT_APP_ARGUMENTS%% --" />
        </activity>

        <!--
            The background fetch (project.md sec 17).

            A job, and the job does the fetch itself (sec 17.7): Android
            refuses both a background and a foreground service started
            from a job while the app is closed, and runs the job, for up
            to ten minutes and without a notification.

            It runs the same native library as the activity, so it is the
            same fetch: android.app.arguments makes main() take the
            headless path, and the job's loader reads these three the
            way Qt's own service loader reads a QtService's.
            background_running tells Qt there is no activity behind it
            to wait for.

            ITS OWN PROCESS, and that is not tidiness. Qt permits one
            application per process and the activity's process already
            has one.

            BIND_JOB_SERVICE because the platform refuses to bind a job
            service without it. exported=false: nothing outside this
            package has any reason to start it.
        -->
        <service
            android:name=".FetchJobService"
            android:process=":fetch"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false">
            <meta-data
                android:name="android.app.lib_name"
                android:value="-- %%INSERT_APP_LIB_NAME%% --" />
            <meta-data
                android:name="android.app.arguments"
                android:value="--android-service" />
            <meta-data
                android:name="android.app.background_running"
                android:value="true" />
        </service>

        <!--
            The home-screen widget (project.md sec 16).

            exported=true is required: the widget host is the launcher,
            a different application, and it is what sends the update
            broadcast. There is nothing to protect here: the receiver reads
            a picture this package wrote and displays it.
        -->
        <receiver
            android:name=".GraphWidget"
            android:label="@string/bbq_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bbq_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.qtprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/qtprovider_paths"/>
        </provider>
    </application>
</manifest>
