# Build output. BUILD_DIR is settable, so this covers the default and the
# conventional variants rather than every path somebody might pass.
/build/
/build-*/
/build-test/
/bbq-predictor
/bbq-predictor.new

# qmake droppings
.qmake.stash
Makefile.qmake
*.o
*.moc
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h

# Editor and tooling state
*~
*.swp
__pycache__/

# The scraped Weather Underground key, and anything else cached at
# runtime, must never reach a commit. It is not ours to redistribute, and
# a key in a public history is a key that gets revoked (project.md sec 2).
/cache/
*.key

# Cross-compiled Android dependencies (tool/build-openssl-android.sh).
deps/

# fmake's object cache. It appears the first time anyone builds with the
# fmake.toml beside it, is rebuilt from source, and is therefore output --
# but fmake appends the bare line itself, so this says why.
.fmake/
