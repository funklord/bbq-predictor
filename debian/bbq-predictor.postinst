#!/bin/sh
set -e

#DEBHELPER#

# The archive's directory. On a systemd host the unit's StateDirectory=
# makes it; where cron runs the fetch instead, nothing would, and the
# first round would fail for want of somewhere to write.
if [ "$1" = "configure" ]; then
	install -d -o bbq-predictor -g bbq-predictor -m 0755 /var/lib/bbq-predictor
fi
