#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

# The -dbgsym package is built whether or not anything generated debug
# info, so without this it ships a build-id link and no symbols --
# lintian's debug-file-with-no-debug-symbols. The release build does not
# carry -g on its own; DEBUG_INFO adds it without making this a debug
# build, and dh_strip moves the result out of the shipped binary.
override_dh_auto_build:
	$(MAKE) DEBUG_INFO=1

# PREFIX is /usr/local by default, which is right for a hand-built copy
# and wrong for a package. Into debian/tmp, because two packages now take
# their files from one install: each .install file names its own.
override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr

# The archive server's LSB script, installed by its .install file from
# packaging/ so there is one copy of it; this adds only the update-rc.d
# registration. Not started on install: port 443 may belong to something
# else, and until the publisher has run there is nothing to serve.
override_dh_installinit:
	dh_installinit -pbbq-predictor-server --name=bbq-predictor-serve \
	        --onlyscripts --no-start

# The service is oneshot and triggered by the timer, so it carries no
# [Install] section and is never started on install -- an install-time
# start would fetch before anybody had named a station. The timer is what
# gets enabled and started, and it is what makes the archive advance.
# Both are the server's since 0.1.0-2: the round is the publisher.
override_dh_installsystemd:
	dh_installsystemd -pbbq-predictor-server --no-start bbq-predictor-fetch.service
	dh_installsystemd -pbbq-predictor-server --restart-after-upgrade \
	        bbq-predictor-fetch.timer
	dh_installsystemd -pbbq-predictor-server --no-start --no-enable \
	        bbq-predictor-serve.service

# bbq-predictor(1) cites /usr/share/doc/bbq-predictor/project.md, and
# dh_compress would gzip anything over 4k in that directory -- leaving the
# page citing a path that does not exist. A reference that does not
# resolve is worse than none, so the design record stays readable at the
# name the page gives. (The units cite their manual pages instead, since
# the server package does not carry the design record.)
override_dh_compress:
	dh_compress -X.md
