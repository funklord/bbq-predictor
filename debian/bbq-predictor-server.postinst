#!/bin/sh
set -e

#DEBHELPER#

# The publisher's state directory and the tree the daemon chroots into
# (project.md sec 15.12.2, 15.13). Both belong to the publisher's account,
# made by this package's sysusers snippet above: the round writes its lock,
# key and archive into the first, and the daemon -- which runs as
# bbq-predictor-serve -- can read the second and write nothing.
#
# Made here because on a systemd host the unit's StateDirectory= would
# make the first, and where cron runs the round instead nothing does. It
# was the applet's postinst until 0.1.0-2 moved the round to this package,
# and the first round under cron after the move failed on a root-owned
# directory until it came across too. The getent stays for a host where
# account creation was skipped, which leaves root-owned directories rather
# than a failed install.
if [ "$1" = "configure" ]; then
	owner=root
	if getent passwd bbq-predictor >/dev/null; then
		owner=bbq-predictor
	fi
	install -d -o "$owner" -g "$owner" -m 0755 /var/lib/bbq-predictor
	install -d -o "$owner" -g "$owner" -m 0755 /var/lib/bbq-predictor/published

	# The demand file (sec 15.14): the daemon appends to it, opening it as
	# root before it drops, and the publisher reads and empties it, so it
	# is the publisher's. Made only if absent, never truncated by an
	# upgrade. The daemon refuses to create it, since root would own it.
	if [ ! -e /var/lib/bbq-predictor/demand ]; then
		install -o "$owner" -g "$owner" -m 0600 /dev/null /var/lib/bbq-predictor/demand
	fi
fi
