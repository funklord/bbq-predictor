[Unit]
# One fetch of every band into the shared archive (project.md sec 15.1).
#
# A phone only fetches while somebody is looking at it, so the archive
# advances in bursts and verification cannot accumulate for a station
# nobody opens. This is the fetching half of the server: it collects and
# scores on its own clock. Publishing is not implemented yet -- sec 15.5
# has the format questions that must be settled first.
Description=Fetch weather bands into the bbq-predictor archive
Documentation=file:///usr/share/doc/bbq-predictor/project.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# 3 is a run where some band failed but the composite still covers
# now -- a station gone quiet for an hour, which is ordinary. The
# archive advanced and verification accumulated, so the unit did its
# job. 1 still fails, and 1 is what a run that stored nothing usable
# returns, so this forgives the partial case by name rather than
# forgiving every failure.
SuccessExitStatus=3

# The program builds a QApplication before it reads its arguments, so a
# headless run needs a platform plugin that asks for no display.
Environment=QT_QPA_PLATFORM=offscreen

EnvironmentFile=-/etc/default/bbq-predictor

# A FIXED SYSTEM USER, NOT DynamicUser (project.md sec 16.15).
#
# DynamicUser is the better default and is wrong here. It puts
# StateDirectory under /var/lib/private, which systemd keeps
# inaccessible to unprivileged users so that a recycled dynamic uid
# cannot reach it -- and that made the archive root-only. The archive is
# what this whole service exists to build, and every question anybody
# has asked of this program has been answered by opening one and
# querying it. One the owner cannot read is one they will not read.
#
# The account is created by sysusers.d at install time. What is given up
# is uid-recycling isolation, which a fixed system account does not have
# to worry about in the first place.
User=bbq-predictor
Group=bbq-predictor

# 0755 rather than the default it happens to share: the readability is
# the point of the two lines above, so it is stated rather than
# inherited. The archive inside lands 0644 under the default umask.
StateDirectory=bbq-predictor
StateDirectoryMode=0755

# ExecCondition rather than a test inside ExecStart, because the two
# outcomes are different: a non-zero ExecCondition SKIPS the run and says
# why, while the same exit from ExecStart marks the unit failed. An
# unconfigured machine would otherwise collect a failure every five
# minutes for ever, and a package installed for the applet alone would
# look broken. 78 is EX_CONFIG, so the skip names its own reason.
ExecCondition=/bin/sh -c 'test -n "$BBQ_STATION" || { echo "BBQ_STATION is unset: set it in /etc/default/bbq-predictor" >&2; exit 78; }'

ExecStart=/usr/bin/bbq-predictor --fetch-once --station ${BBQ_STATION} --history-path ${STATE_DIRECTORY}/history.sqlite

# It talks to three weather APIs and writes one file. Nothing else.
NoNewPrivileges=yes

# Stated because DynamicUser implied it and cannot be turned off there,
# so dropping DynamicUser dropped this silently. PrivateTmp was implied
# by it too and was already stated below. The account is this unit's
# alone, so removing its IPC on stop takes nothing else with it.
RemoveIPC=yes

PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=yes
SystemCallFilter=@system-service
